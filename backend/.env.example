APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false
APP_INTERPRETER=echo
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the exact LAN origin used to open the bundled Operator UI, if applicable.
# Example: APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.20:8080

# Required for Operator access. These are independent values.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_OPERATOR_PASSWORD=
# Server-only session cookie signing key; not a second login password.
# This has no relation to the Sermon Session feature.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_OPERATOR_SESSION_SECRET=

# Keys are stored in backend/data/operator.json from the operator Settings page.
# APP_INTERPRETER is the fallback when that file does not exist.
APP_OPENAI_API_KEY=

# empty = default input device. index number or name substring
# APP_AUDIO_DEVICE=
APP_AUDIO_CHUNK_FRAMES=1024
APP_INPUT_SAMPLE_RATE=16000
# Maximum queued translation audio duration; oldest audio is dropped above this limit.
APP_TRANSLATION_QUEUE_MAX_SECONDS=2.0
# Maximum time to drain pending translation audio during a normal stop.
APP_TRANSLATION_DRAIN_TIMEOUT_SECONDS=2.0
