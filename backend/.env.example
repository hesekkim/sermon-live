APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false

# Set both files to enable HTTPS/WSS. Leave both empty for the existing HTTP mode.
APP_SSL_CERTFILE=
APP_SSL_KEYFILE=

# Add the exact LAN origin used to open the bundled Operator UI, if applicable.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Example: APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.20:8080

# Required for Operator access. These are independent values.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_OPERATOR_PASSWORD=
# Server-only session cookie signing key; not a second login password.
# This has no relation to the Sermon Session feature.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_OPERATOR_SESSION_SECRET=

# Interpreter, API key, audio input, and session timing are configured in Operator settings.
