APP_HOST=0.0.0.0
APP_PORT=8080
APP_DEBUG=false
APP_INTERPRETER=echo
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# echo: no API key. gemini needs APP_GEMINI_API_KEY
# APP_INTERPRETER=gemini
# APP_GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
APP_TURN_SILENCE_MS=180
APP_GEMINI_VOICE=Aoede

# empty = default input device. index number or name substring
# APP_AUDIO_DEVICE=
APP_AUDIO_CHUNK_FRAMES=1024
APP_INPUT_SAMPLE_RATE=16000
APP_OUTPUT_SAMPLE_RATE=24000
